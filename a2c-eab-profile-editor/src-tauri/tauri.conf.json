{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "a2c EAB Profile Editor",
  "version": "0.1.0",
  "identifier": "io.github.grindsa.a2c-eab-profile-editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "a2c EAB Profile Editor",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
